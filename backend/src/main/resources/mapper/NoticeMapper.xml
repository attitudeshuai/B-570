<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.property.mapper.NoticeMapper">
    
    <resultMap id="NoticeResultMap" type="Notice">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="type" column="type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <select id="findAllByOrderByCreatedAtDesc" resultMap="NoticeResultMap">
        SELECT id, title, content, type, created_at
        FROM notice
        ORDER BY created_at DESC
    </select>
    
    <select id="findById" resultMap="NoticeResultMap">
        SELECT id, title, content, type, created_at
        FROM notice
        WHERE id = #{id}
    </select>
    
    <insert id="insert" parameterType="Notice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice (title, content, type, created_at)
        VALUES (#{title}, #{content}, #{type}, NOW())
    </insert>
    
    <update id="update" parameterType="Notice">
        UPDATE notice
        SET title = #{title},
            content = #{content},
            type = #{type}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM notice WHERE id = #{id}
    </delete>
    
</mapper>
